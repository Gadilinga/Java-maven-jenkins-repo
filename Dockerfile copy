# ============================================
# Stage 1: Builder - install dependencies only
# ============================================
FROM python:3.11-slim AS builder

# Prevents Python from writing .pyc files and ensures output is flushed
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/root/.local/bin:$PATH

WORKDIR /app

# Install system build dependencies temporarily
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first for caching benefits
COPY requirements.txt .

# Install Python dependencies to a custom directory (for copy efficiency)
RUN pip install --no-cache-dir --user -r requirements.txt


# ============================================
# Stage 2: Runtime - minimal production image
# ============================================
FROM python:3.11-slim AS runtime

# Create app user and directories early to avoid cache invalidation
RUN useradd --create-home --shell /bin/bash app \
    && mkdir -p /app /home/app/.local /app/logs /app/uploads \
    && chown -R app:app /app /home/app

# Install only runtime dependencies (smaller image)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /root/.local /home/app/.local

# Copy application code
WORKDIR /app
COPY --chown=app:app . .

# Switch to non-root user
USER app

# Add user local bin to PATH
ENV PATH=/home/app/.local/bin:$PATH \
    PYTHONPATH=/app \
    FLASK_APP=app.py \
    FLASK_ENV=production

# Expose Flask port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# Default command (use gunicorn for production)
CMD ["gunicorn", "--config", "gunicorn.conf.py", "app:create_app()"]
