// pipeline to automate the build of java application using maven 
pipeline{
   
    agent any

    tools{
        maven 'maven 3.9.11' //needs a check from the jenkins server tools to validate the right version of plugin
    }

    stages{
        
        stage("build the JAR file"){
            echo "build the JAR artifact using maven"
            sh 'mvn package' 
        }

        stage("build the container image"){
            
            echo " Building the docker image based on the artifact file "

            withCredentials([usernamePassword(credentialsId:'gitlab-credentials', usernameVariable:'USERNAME', passwordVariable:'PASSWORD')])
     
            sh 'docker build -t abdelhamedelbadawy/jenkinsbuiltapplication:jmaimage-1.0 \ -t abdelhamedelbadawy/jenkinsbuiltapplication:jmaimage-initial .'  
            
            sh "echo $PASSWORD | docker login -u $USERNAME --password-stdin "

            sh 'docker push abdelhamedelbadawy/jenkinsbuiltapplication --all-tags'
        }
    }
}









}